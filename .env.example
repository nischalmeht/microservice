NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# MongoDB connection URI (with docker.yml: mongodb://mongo:27017/microservice-development)
MONGO_HOST=mongodb://localhost:27017/microservice-development
MONGOOSE_DEBUG=false

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Placeholder credentials accepted by POST /api/auth/login
AUTH_USERNAME=change-me
AUTH_PASSWORD=change-me
